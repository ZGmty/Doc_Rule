{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZGmty/Doc_Rule/schemas/rule.schema.json",
  "title": "Doc_Rule rule catalog item",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "category",
    "severity",
    "applies_to",
    "file",
    "dedup_signature",
    "authoring_guard",
    "review_check"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DR-[A-Z]{3}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "superseded"]
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "file": {
      "type": "string",
      "pattern": "^rules/.+\\.md$"
    },
    "dedup_signature": {
      "type": "string",
      "minLength": 8
    },
    "authoring_guard": {
      "type": "string",
      "minLength": 8
    },
    "review_check": {
      "type": "string",
      "minLength": 8
    },
    "detection_hints": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}