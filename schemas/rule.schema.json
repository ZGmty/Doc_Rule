{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZGmty/Doc_Rule/schemas/rule.schema.json",
  "title": "Doc_Rule rule catalog item",
  "type": "object",
  "required": ["id", "title", "category", "severity", "applies_to", "file"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DR-[A-Z]{3}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "file": {
      "type": "string",
      "pattern": "^rules/.+\\.md$"
    },
    "detection_hints": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}